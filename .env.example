# Shared local development environment (docker-compose reads this file)
POSTGRES_USER=fairqueue
POSTGRES_PASSWORD=fairqueue
POSTGRES_DB=fairqueue

DATABASE_URL=postgresql://fairqueue:fairqueue@localhost:5432/fairqueue?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-change-me
# naive = deliberately broken "before" build used for benchmarks
# fairqueue = queue + atomic holds + rate limits
MODE=fairqueue
API_PORT=4000

# Bot protection.
# How much looser the per-address rate limit is than the per-account one.
# Offices and mobile networks put many real buyers behind one address, and a
# load generator puts every virtual user behind one, so this is deliberately
# generous. The per-account limit does the real work.
RATE_LIMIT_IP_FACTOR=20
# Only ever 'false' in the test suites that prove the locking guarantees, where
# thousands of requests come from one address on purpose.
RATE_LIMIT_ENABLED=true

# Live events (optional).
# Leave blank and FairQueue runs exactly as before on its seeded catalogue —
# the app, the tests and the benchmarks must never need credentials.
# Free key: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=
# Ticketmaster has strong coverage in GB/US/CA/AU and literally zero events in
# India, so the country here decides whether live events appear at all.
EVENT_SYNC_COUNTRY=GB
# What to pull: "Music" keeps the catalogue to concerts and live shows.
EVENT_SYNC_CLASSIFICATION=Music
EVENT_SYNC_LIMIT=24
# How often to refresh. 0 disables the scheduled sync; the benchmarks use 0.
EVENT_SYNC_INTERVAL_MINUTES=360

# Authentication.
TOKEN_ISSUER=fairqueue
TOKEN_AUDIENCE=fairqueue-api
# false on plain-http local development, where a Secure cookie would be
# refused by the browser. true everywhere real.
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173

# Google sign-in (optional). With no credentials the button is hidden and
# password login carries on exactly as before.
# Console: https://console.cloud.google.com/apis/credentials
# The redirect URI below must be registered there as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
