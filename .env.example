# Shared local development environment (docker-compose reads this file)
POSTGRES_USER=fairqueue
POSTGRES_PASSWORD=fairqueue
POSTGRES_DB=fairqueue

DATABASE_URL=postgresql://fairqueue:fairqueue@localhost:5432/fairqueue?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-change-me
# naive = deliberately broken "before" build used for benchmarks
# fairqueue = queue + atomic holds + rate limits
MODE=fairqueue
API_PORT=4000

# Bot protection.
# How much looser the per-address rate limit is than the per-account one.
# Offices and mobile networks put many real buyers behind one address, and a
# load generator puts every virtual user behind one, so this is deliberately
# generous. The per-account limit does the real work.
RATE_LIMIT_IP_FACTOR=20
# Only ever 'false' in the test suites that prove the locking guarantees, where
# thousands of requests come from one address on purpose.
RATE_LIMIT_ENABLED=true

# Live events (optional).
# Leave blank and FairQueue runs exactly as before on its seeded catalogue —
# the app, the tests and the benchmarks must never need credentials.
# Free key: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=
EVENT_SYNC_COUNTRY=GB
EVENT_SYNC_LIMIT=24
