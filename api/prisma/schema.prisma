// Permanent record of what was sold. Redis holds the fast temporary state
// (queue, holds); anything we must never lose lives here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ADMIN
}

enum EventStatus {
  UPCOMING
  LIVE
  PAUSED
  SOLD_OUT
}

/// Where an event's real-world details came from.
///
/// This is about the *event*, never the tickets. FairQueue's seat inventory,
/// prices, payments and tickets are simulated for every event without
/// exception — including the ones whose details are genuine.
enum EventSourceKind {
  /// Invented for demos and benchmarks. Not a real event.
  SEEDED
  /// Fetched live from the Ticketmaster Discovery API.
  TICKETMASTER
  /// Taken by hand from an official organiser announcement or schedule, with
  /// the source URL recorded so anyone can check the claim.
  VERIFIED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())

  orders Order[]
}

model Event {
  id              String      @id @default(cuid())
  name            String
  venue           String
  startsAt        DateTime
  saleOpensAt     DateTime
  status          EventStatus @default(UPCOMING)
  // How many queued users the worker admits each second.
  admitPerSec     Int         @default(50)
  maxSeatsPerUser Int         @default(4)
  createdAt       DateTime    @default(now())

  // --- where the real-world details came from ---
  //
  // Everything below describes the event, not the tickets. Seats, prices,
  // payment and tickets are simulated for every event here, real or not.
  source       EventSourceKind @default(SEEDED)
  // The provider's own id. Null for seeded events, which have no provider.
  externalId   String?
  category     String?
  city         String?
  country      String?
  // The page these details were taken from, so a reader can verify them
  // rather than taking our word for it. Required for anything not SEEDED.
  sourceUrl    String?
  sourceName   String?
  // When a human confirmed a VERIFIED entry against its source.
  verifiedAt   DateTime?
  // When a sync last refreshed this from its provider.
  lastSyncedAt DateTime?

  seats   Seat[]
  orders  Order[]
  tickets Ticket[]

  // One row per provider event. Postgres treats NULLs as distinct, so any
  // number of seeded events coexist while a provider event can only land once
  // and a re-sync updates it instead of duplicating it.
  @@unique([source, externalId])
  @@index([city])
  @@index([category])
}

model Seat {
  id      String @id @default(cuid())
  eventId String
  section String
  row     String
  number  Int
  // Price in cents, so money is never a float.
  price   Int
  // Position on the SVG seat map.
  x       Float
  y       Float

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([eventId, section, row, number])
  @@index([eventId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  total     Int
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([userId])
  @@index([eventId])
}

model Ticket {
  id      String @id @default(cuid())
  orderId String
  eventId String
  seatId  String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seat  Seat  @relation(fields: [seatId], references: [id], onDelete: Cascade)

  // The last line of defense against double-selling: even if every lock above
  // this fails, the database physically cannot store the same seat twice.
  @@unique([eventId, seatId])
  @@index([orderId])
}
